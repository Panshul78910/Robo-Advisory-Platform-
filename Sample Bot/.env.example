# Copy to .env beside bot.py. Never share your filled-in .env.
# Native server: this computer only. Set 0.0.0.0 if the Docker app cannot reach it.
BREWBOT_HOST=127.0.0.1
BREWBOT_PORT=5056
# Scripted coffee demo only. RoboBot model modes need a real model; Strict works offline.
BREWBOT_OFFLINE=false
BREWBOT_TIMEOUT=60
BREWBOT_MODEL=gemma-3-12b
# Leave blank to use LLM_ENDPOINT / LLM_API_KEY in the provided .env (local or ../.env).
BREWBOT_BASE_URL=
BREWBOT_API_KEY=
