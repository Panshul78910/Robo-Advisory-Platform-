# Copy to .env and fill in. NEVER commit .env.

# --- Database -----------------------------------------------------------
# Which database this process talks to: local | supabase
DB_TARGET=local

# Local container from this repo's docker-compose.yml.
# (Supabase CLI local stack instead? use port 54322.)
DATABASE_URL_LOCAL=postgresql://postgres:postgres@127.0.0.1:54329/postgres

# The hosted project. This is a POSTGRES CONNECTION STRING, not an API key --
# `sb_publishable_...` and `sb_secret_...` are for the Supabase REST API, which
# this backend never calls. Copy the URI from:
#   Supabase dashboard -> Project Settings -> Database -> Connection string -> URI
#
# Prefer the connection pooler; the direct `db.<ref>.supabase.co` host is
# IPv6-only on newer projects unless you have the IPv4 add-on.
#   port 6543 = transaction pooler (prepared statements auto-disabled for you)
#   port 5432 = session pooler
DATABASE_URL_SUPABASE=

# Optional escape hatch: when set, this wins over DB_TARGET entirely.
# DATABASE_URL=

# --- Auth ---------------------------------------------------------------
# This service issues and verifies its own tokens; it is NOT a Supabase Auth
# client, so no Supabase project API key is needed. Supabase, if you use it, is
# only a local Postgres and a migration runner -- reached via DATABASE_URL.
#
# (For reference: Supabase now issues `sb_publishable_...` / `sb_secret_...`
# keys and signs tokens asymmetrically via JWKS. The legacy anon/service_role
# JWTs and the shared HS256 "JWT secret" are deprecated. None of that applies
# here, because nothing in this codebase calls the Supabase API.)
#
# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# (SUPABASE_JWT_SECRET is accepted as an older spelling of this.)
JWT_SECRET=dev-only-insecure-secret-change-me-0123456789abcdef

# --- HPC LLM endpoint ---------------------------------------------------
# Use the names the course publishes. A bare `host:port` is fine -- the scheme
# is added for you -- and LLM_MODELS may list several, in which case the first
# is used, so reorder it to pick a different one.
LLM_ENDPOINT=
LLM_API_KEY=
LLM_MODELS=

# HPC_BASE_URL / HPC_API_KEY / HPC_MODEL_NAME are accepted as older spellings.
# If both are present the LLM_* values win; `make check` says which was used.

# Placeholder until `python -m scripts.probe_hpc` measures the real ceiling.
HPC_CONTEXT_LIMIT=8192

# --- personal OpenAI account (fallback) ----------------------------------
# A stand-in for when the shared endpoint is down. Both speak the same
# chat-completions protocol, so switching changes nothing but these values.
#
# Note this bills a real account and sends prompts to a third party. The client
# data in them is synthetic, but it does leave the machine.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Override only for Azure OpenAI or a local proxy (LM Studio, Ollama, vLLM).
# OPENAI_BASE_URL=https://api.openai.com

# --- which one to use ----------------------------------------------------
#   stub   offline, deterministic, no network or key -- the default
#   hpc    the shared course endpoint (LLM_ENDPOINT above)
#   openai your own OpenAI key
# Misconfiguration fails loudly rather than silently falling back to the stub.
LLM_BACKEND=stub

#LLM_ENDPOINT="https://llm.earthobservatory.sg:8443/v1"
#LLM_API_KEY="lgw_<YOUR API KEY>"
#LLM_MODELS="qwen3.6-35b-a3b-fp8, gemma-3-12b, qwen3-4b"  

# --- resilience (B.6) ----------------------------------------------------
# Shared by every backend on purpose: the behaviour Part B is graded on should
# not change with the provider.
HPC_CONNECT_TIMEOUT_S=5.0
HPC_READ_TIMEOUT_S=60.0
HPC_MAX_ATTEMPTS=3
HPC_BACKOFF_BASE_S=0.5
HPC_BACKOFF_CAP_S=8.0
# Consecutive failures before the breaker opens, and how long it stays open.
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_COOLDOWN_S=30.0

# --- RAG ----------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# hash = deterministic dependency-free embedder used by tests; local = sentence-transformers
EMBEDDING_BACKEND=local

# Cosine similarity a passage must reach to count as grounding. CORPUS-SPECIFIC,
# not just model-specific: more chunks means more surface for a spurious match.
# Measured on the five-document corpus -- genuine queries 0.42-0.70, nonsense
# 0.00-0.27 -- so this sits at the midpoint. Re-measure after a big ingest; a
# floor left behind by a growing corpus stops abstaining, which looks like
# success.
RELEVANCE_FLOOR=0.34

# Passages kept after fusion, and candidates pulled from each arm before it.
RETRIEVAL_TOP_K=6
RETRIEVAL_CANDIDATES=20

# Below this, a response is routed to human review rather than merely flagged.
LOW_CONFIDENCE_THRESHOLD=0.60

# Chunking, applied on the next `make ingest`. The target is a ceiling, not a
# quota: the chunker splits on headings first, so a document whose sections are
# shorter never reaches it.
CHUNK_TARGET_TOKENS=500
CHUNK_OVERLAP_RATIO=0.15

# --- Part D: the semantic judge (D.1(3) LLM-as-a-Judge) ------------------
# Needs Ollama running with both models pulled:
#   ollama pull llama-guard3:1b && ollama pull qwen2.5:7b-instruct
#
# Off by default so tests and the stub never need Ollama. Turn ON for Part D.
# Leave it OFF for the Part B demo: it adds 6-35x latency and hides the circuit
# breaker, and Part B does not need it.
JUDGE_ENABLED=false

# false = an unreachable judge BLOCKS the request (fail closed, safer).
# true  = the request proceeds on the regex layer alone.
JUDGE_FAIL_OPEN=false

OLLAMA_URL=http://localhost:11434
JUDGE_MODEL=qwen2.5:7b-instruct
# Model for the EGRESS faithfulness check only; blank = use JUDGE_MODEL.
# Latency on CPU is dominated by prompt evaluation, and it falls off a cliff:
# ~530 prompt tokens costs ~4.5s, ~1170 costs 23-42s. Faithfulness carries the
# longest prompt (facts + policy + reply), so it pays that cost worst.
# Splitting it onto a smaller model halves it. Safe because the two jobs differ:
# on the red-team set the 3B misses 5 attacks, ALL of them injection/jailbreak,
# which judge_input handles -- not faithfulness.
FAITH_MODEL=qwen2.5:3b-instruct
GUARD_MODEL=llama-guard3:1b

# --- hosted judges: the same two checks, off this machine -----------------
# Judge latency here is hardware, not prompting: inference is memory-bandwidth
# bound and ~10 tok/s on a 7B is what system RAM can sustain. Hosting the two
# large judges removes that ceiling without touching their prompts.
#
# Any OpenAI-compatible chat-completions endpoint works -- Groq, OpenRouter,
# Google, Together, the course HPC. Only URL, key and model names differ.
#
# Leave JUDGE_API_KEY or HOSTED_JUDGE_MODEL blank and nothing changes: Ollama
# serves every call as before. When set, ANY hosted failure (bad key, rate
# limit, timeout, empty or non-JSON reply) falls back to the local model,
# because JUDGE_FAIL_OPEN=false means a judge that cannot answer blocks the
# request. Every fallback is logged as "hosted judge unavailable".
#
# Check what a key can actually reach, and time one judge-shaped call:
#   python -m scripts.hosted_models
#   python -m scripts.hosted_models --time <model>
# false forces every judge local without clearing the key or model names --
# the switch to flip for a hosted-vs-local comparison.
HOSTED_JUDGE_ENABLED=true
JUDGE_API_KEY=
JUDGE_BASE_URL=https://api.groq.com/openai/v1
HOSTED_JUDGE_MODEL=
# Blank falls back to HOSTED_JUDGE_MODEL.
HOSTED_FAITH_MODEL=
# Short on purpose: a slow hosted judge has failed and the local one is ready.
HOSTED_TIMEOUT_S=20.0

# --- backup key -----------------------------------------------------------
# Tried when the primary key fails, before anything falls back to Ollama. The
# full chain is: JUDGE_API_KEY -> BACKUP_API_KEY -> local model (judges) or
# skipped entirely (refusal rewriting, vagueness check -- neither has a local
# model, and both are designed to be skippable).
#
# The case it exists for is a free tier's rate limit, which arrives as a fast
# 429, so the second key costs roughly 100ms. An expired or revoked key fails
# just as fast and takes the same path. A hung provider is the exception: a
# timeout costs its full budget before the next key is tried, which is why the
# timeouts above and below are small.
#
# Blank disables the chain and behaviour is exactly as before: primary, then
# local. Every fallback is logged as "hosted key failed", and a call the backup
# served is logged as "hosted call served by backup key" -- so a run that
# quietly spent itself on the second key is visible rather than inferred.
BACKUP_API_KEY=
# Blank = same provider as JUDGE_BASE_URL, a second key on another account,
# which is the usual arrangement. Set it to put the backup on a DIFFERENT
# provider -- the model names must then exist there too, or it 404s and the
# local model takes over.
BACKUP_BASE_URL=

# --- refusal rewriting ----------------------------------------------------
# When a check blocks a message, rewrite the approved refusal template so it
# names what was declined ("I can't help with customer support hours") instead
# of returning the same sentence for every blocked request.
#
# OFF by default, and the default is the point: this is the one place where text
# just judged an attack is handed to a model with no guardrails of its own and
# asked to write what the client reads. Benchmarked on this task, a small model
# given an injected instruction obeyed it and wrote "APPROVED. P8 granted." as
# the refusal. Every rewrite is validated before it ships and anything doubtful
# falls back to the template, but the safest setting is still the one that never
# calls out. Uses the hosted provider configured above.
REFUSAL_REWRITE_ENABLED=false
# Blank falls back to HOSTED_JUDGE_MODEL.
REFUSAL_MODEL=
# A blocked request is already decided; only its wording is in question, and no
# wording is worth a wait. Slow means: ship the template.
REFUSAL_TIMEOUT_S=6.0

# --- vagueness check ------------------------------------------------------
# "Tell me more", "what about that one", "sort it out" -- messages that do not
# say enough to answer. ON, these get a fixed request to rephrase instead of a
# guess or an abstention about missing evidence.
#
# Safer than the rewriter by construction: this model returns only a boolean and
# the client sees a fixed string, so no text derived from the message can reach
# them. It runs ONLY on messages the deterministic layer could not place, after
# the regex and judge layers have had their say, so a clean question pays nothing
# and a vague attack is refused rather than invited to rephrase. Fails open: an
# unreachable checker means the message proceeds exactly as it did before.
VAGUENESS_CHECK_ENABLED=false
# Blank falls back to HOSTED_JUDGE_MODEL.
VAGUENESS_MODEL=
VAGUENESS_TIMEOUT_S=5.0

# Per call, and the egress faithfulness check is the one that needs the room --
# its cost scales with the reply plus the retrieved policy. Judge requests also
# ask Ollama to keep the model resident, so a cold reload no longer eats this.
JUDGE_TIMEOUT_S=120.0

# --- Part D: demonstration switches --------------------------------------
# All default to the safe setting. Each exists so a guardrail's ABSENCE can be
# captured reproducibly, instead of editing code mid-demo and forgetting to put
# it back.
#
# D.1(1) data grounding. false makes retrieval return nothing, so the model
# answers with no evidence -- the "before" capture. The corpus is left intact,
# unlike resetting the store, so "after" needs only a restart.
RAG_ENABLED=true
#
# D.1(2) prompt engineering. "minimal" selects prompts/system_minimal.md: the
# same system prompt without the enforced-citation, no-guarantee and abstention
# rules, and without the empty-evidence instruction in the context builder. The
# active variant changes prompt_version, so every decision records which prompt
# produced it.
PROMPT_VARIANT=full
#
# Turn individual guardrails off by name, or `all` for the Pass A captures:
#   GUARDRAILS_DISABLE=all
#   GUARDRAILS_DISABLE=injection,leak
# Names: toxic, scope, injection, leak, multiturn, untrusted, judge, grounding,
#        verify, pii, abstain
# NOTE: PowerShell needs $env:GUARDRAILS_DISABLE="all"; `set NAME=value` is cmd
# syntax and silently does nothing in PowerShell.
GUARDRAILS_DISABLE=
#
# B.6 fault injection, read once at boot. With it on, an `X-Fault-Inject` header
# (timeout | rate_limited | server_error | unreachable | slow) drives a real
# failure through the retry and breaker path. Inert without it, so a client can
# never trigger it.
ALLOW_FAULT_INJECTION=false

# --- market data (A.5) ---------------------------------------------------
STARTING_CASH=50000.00
# Appendix C price service. Left blank, prices come from the seeded CSVs.
# (APPENDIX_C_PRICE_URL is accepted as an older spelling.)
PRICE_SERVICE_URL=
PRICE_SOURCE_LABEL=Appendix C prices (JSON price service)
PRICE_JSON_PATH=/api/market/prices

# --- auth ----------------------------------------------------------------
JWT_AUDIENCE=authenticated
JWT_TTL_SECONDS=28800

# --- logging -------------------------------------------------------------
LOG_LEVEL=INFO
# json   = one line per event; the machine-readable record and the B.7 evidence.
# pretty = the same fields laid out over several lines, with nested lists such as
#          retrieved chunks and context blocks drawn as aligned tables. For
#          explaining a running system to someone watching the terminal.
# Redaction is shared by both, so this cannot widen what is exposed.
LOG_FORMAT=json
# One JSON line per HTTP request. On by default because the rest of this log is
# event-driven: without it a healthy server is silent, which is indistinguishable
# from a hung one.
ACCESS_LOG=true
